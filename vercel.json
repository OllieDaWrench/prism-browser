{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    },
    "api/auth/home.js": {
      "includeFiles": "private/*.html"
    },
    "api/download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/api/auth/home" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/gate.html" },
    { "source": "/live/status", "destination": "/api/live" },
    { "source": "/live/warm", "destination": "/api/live" },
    { "source": "/install.sh", "destination": "/api/install" },
    { "source": "/install", "destination": "/api/install" },
    { "source": "/download/app/:app/:platform", "destination": "/api/app-download?app=:app&platform=:platform" },
    { "source": "/download/:platform", "destination": "/api/download?platform=:platform" },
    { "source": "/https/:path*", "destination": "/api/proxy?__path=https/:path*" },
    { "source": "/http/:path*", "destination": "/api/proxy?__path=http/:path*" },
    { "source": "/p/:path*", "destination": "/api/proxy?__path=p/:path*" },
    { "source": "/r/:path*", "destination": "/api/proxy?__path=r/:path*" },
    { "source": "/(.*)", "destination": "/api/proxy?__path=$1" }
  ]
}
